{
  "name": "td-defense",
  "productName": "TD Defense",
  "version": "1.0.0",
  "description": "TD Defense - Tower Defense futurista militar (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win portable --x64",
    "exe": "node scripts/build-exe.mjs",
    "exe:linux": "node scripts/build-exe.mjs --linux-only"
  },
  "author": "ZaBaDeVgit",
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.1"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postject": "1.0.0-alpha.6",
    "vite": "^5.4.21"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.zabadev.tddefense",
    "productName": "TD Defense",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TDDefense-${version}.exe"
    }
  }
}
